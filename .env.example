# Database (Vercel Postgres / Neon). Vercel sets this automatically once the
# database is connected to the project; copy it to .env.local for local dev.
DATABASE_URL=

# Signs admin session cookies. Any random string, 32+ characters.
SESSION_SECRET=

# Vercel Blob (private store) for post images. Set automatically, along with
# OIDC credentials, when the store is connected to the project.
BLOB_STORE_ID=

# Resend. INQUIRY_TO_EMAIL is server-only and must never be exposed to the
# browser (no NEXT_PUBLIC_ prefix). It never appears in page source.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
INQUIRY_TO_EMAIL=
# Sender for Mastermind Minutes emails; falls back to RESEND_FROM_EMAIL.
NEWSLETTER_FROM_EMAIL=

# Client portal (quotes & invoices)
# Sender for quote/invoice emails; falls back to RESEND_FROM_EMAIL.
BILLING_FROM_EMAIL=
# Where client replies to quote/invoice emails go (optional).
BILLING_REPLY_TO=
# Who gets "quote accepted" / "invoice paid" alerts; falls back to INQUIRY_TO_EMAIL.
ADMIN_NOTIFY_EMAIL=
# Stripe (online payments). The Pay button stays off until both are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Consultation booking (Google Calendar behind the on-site booking page).
# OAuth client (Web application) on an Internal consent screen; redirect URI
# https://www.acc-funds.com/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sender for booking emails; falls back to BILLING_FROM_EMAIL / RESEND_FROM_EMAIL.
BOOKING_FROM_EMAIL=
# Vercel sends this as a Bearer token on cron calls (booking reminders).
CRON_SECRET=
