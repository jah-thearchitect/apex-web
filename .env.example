# Database (Vercel Postgres / Neon). Vercel sets this automatically once the
# database is connected to the project; copy it to .env.local for local dev.
DATABASE_URL=

# Signs admin session cookies. Any random string, 32+ characters.
SESSION_SECRET=

# Vercel Blob, for post images. Set automatically when a Blob store is
# connected to the project.
BLOB_READ_WRITE_TOKEN=

# Resend. INQUIRY_TO_EMAIL is server-only and must never be exposed to the
# browser (no NEXT_PUBLIC_ prefix). It never appears in page source.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
INQUIRY_TO_EMAIL=
# Sender for Mastermind Minutes emails; falls back to RESEND_FROM_EMAIL.
NEWSLETTER_FROM_EMAIL=
