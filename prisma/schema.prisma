generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Site admins. Created only with `npm run admin:create` (prompts for the
// password locally, stores a bcrypt hash). There is no sign-up page.
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Failed admin sign-in attempts per email. Cleared on success; once
// `attempts` hits the limit, sign-in is refused until `lockedUntil`.
model LoginAttempt {
  email       String    @id
  attempts    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

// Mastermind Minutes list. `token` is the secret in each email's
// unsubscribe link, so it must never be shown anywhere else.
model Subscriber {
  id             String           @id @default(cuid())
  email          String           @unique
  firstName      String           @default("")
  lastName       String?
  status         SubscriberStatus @default(ACTIVE)
  token          String           @unique @default(cuid())
  source         String?
  createdAt      DateTime         @default(now())
  unsubscribedAt DateTime?
}

// A Mastermind Minutes post. Body is HTML from the admin editor and is
// sanitized again on every render. `sentAt` is set once when the post is
// emailed; a post is never emailed twice.
model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String    @default("")
  coverImage  String?
  bodyHtml    String    @default("")
  publishedAt DateTime?
  sentAt      DateTime?
  sentCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Everyone who has reached the firm through the site, one row per email.
// `sources` records every way they came in ("minutes", "inquiry",
// "booking"); names are filled in from whichever form supplied them.
model Contact {
  id             String    @id @default(cuid())
  email          String    @unique
  firstName      String    @default("")
  lastName       String?
  sources        String[]  @default([])
  lastActivityAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  inquiries      Inquiry[]
  client         Client?
}

// A Consultation-page inquiry, kept even if the notification email fails.
model Inquiry {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  name      String
  email     String
  details   String
  createdAt DateTime @default(now())

  @@index([contactId])
}

// ---------- Client portal ----------

enum ClientStatus {
  LEAD
  ACTIVE
  PAST
}

// A business the firm quotes, bills, and reports to. Linked to the
// Contact for the same email so the whole history stays in one place.
model Client {
  id               String       @id @default(cuid())
  businessName     String
  contactName      String
  email            String
  phone            String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  notes            String?
  status           ClientStatus @default(LEAD)
  stripeCustomerId String?
  contactId        String?      @unique
  contact          Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  quotes           Quote[]
  invoices         Invoice[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([email])
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
}

// A proposal. `token` is the secret in the client's link (/q/<token>).
// Accepting it records who accepted and, if depositPercent > 0, creates
// and sends the deposit invoice.
model Quote {
  id             String      @id @default(cuid())
  number         String      @unique
  token          String      @unique @default(cuid())
  clientId       String
  client         Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title          String
  intro          String      @default("")
  terms          String      @default("")
  validUntil     DateTime?
  depositPercent Int         @default(50)
  status         QuoteStatus @default(DRAFT)
  items          QuoteItem[]
  sentAt         DateTime?
  viewedAt       DateTime?
  acceptedAt     DateTime?
  acceptedName   String?
  declinedAt     DateTime?
  invoices       Invoice[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([clientId])
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position    Int
  description String
  details     String @default("")
  quantity    Int    @default(1)
  unitCents   Int

  @@index([quoteId])
}

enum InvoiceKind {
  STANDARD
  DEPOSIT
  RETAINER
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PAID
  VOID
}

// "Overdue" isn't stored: it's SENT/VIEWED with dueDate in the past.
// `token` is the secret in the client's link (/i/<token>).
model Invoice {
  id                    String        @id @default(cuid())
  number                String        @unique
  token                 String        @unique @default(cuid())
  clientId              String
  client                Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quoteId               String?
  quote                 Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  kind                  InvoiceKind   @default(STANDARD)
  title                 String
  notes                 String        @default("")
  issueDate             DateTime      @default(now())
  dueDate               DateTime
  status                InvoiceStatus @default(DRAFT)
  items                 InvoiceItem[]
  sentAt                DateTime?
  viewedAt              DateTime?
  paidAt                DateTime?
  amountPaidCents       Int           @default(0)
  paymentMethod         String?
  stripeCheckoutId      String?
  stripePaymentIntentId String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([clientId])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int
  description String
  details     String  @default("")
  quantity    Int     @default(1)
  unitCents   Int

  @@index([invoiceId])
}

// Saved line items (e.g. "Monthly Partnership") for quick reuse.
model CatalogItem {
  id          String   @id @default(cuid())
  name        String
  details     String   @default("")
  unitCents   Int
  createdAt   DateTime @default(now())
}

// Sequential document numbers ("quote", "invoice"), incremented atomically.
model Counter {
  name  String @id
  value Int    @default(0)
}

// The firm's details printed on quotes and invoices. Always the one row
// with id "singleton"; edited in Admin -> Settings.
model BusinessSettings {
  id               String  @id @default("singleton")
  legalName        String  @default("Apex Capital Consultants")
  addressLine1     String  @default("")
  addressLine2     String  @default("")
  city             String  @default("")
  state            String  @default("")
  postalCode       String  @default("")
  billingEmail     String  @default("")
  phone            String  @default("")
  paymentTermsDays Int     @default(15)
  depositPercent   Int     @default(50)
  quoteValidDays   Int     @default(30)
  invoiceFooter    String  @default("Thank you for building with Apex.")
  quoteTerms       String  @default("")
  updatedAt        DateTime @updatedAt
}

// ---------- Consultation booking ----------

// Availability rules, edited in Admin -> Settings. `weeklyHours` is JSON
// keyed by weekday (0 = Sunday): {"1": [["10:00","13:30"]], ...}, in `timezone`.
// Defaults mirror the Google appointment schedule this replaced.
model BookingSettings {
  id             String   @id @default("singleton")
  title          String   @default("Consultation")
  description    String   @default("Connect with Apex to discuss your vision.")
  timezone       String   @default("America/New_York")
  durationMin    Int      @default(60)
  bufferMin      Int      @default(15)
  minNoticeHours Int      @default(72)
  windowDays     Int      @default(14)
  weeklyHours    String   @default("{\"0\":[],\"1\":[[\"10:00\",\"13:30\"]],\"2\":[[\"10:00\",\"13:30\"]],\"3\":[[\"10:00\",\"13:30\"]],\"4\":[[\"10:00\",\"13:30\"]],\"5\":[[\"10:00\",\"13:30\"]],\"6\":[[\"14:00\",\"17:30\"]]}")
  updatedAt      DateTime @updatedAt
}

// The Google account the site books into. The refresh token is encrypted
// at rest (AES-256-GCM); it lets the server read free/busy and create
// events without the owner signing in each time.
model GoogleConnection {
  id                    String   @id @default("singleton")
  email                 String
  refreshTokenEncrypted String
  calendarId            String   @default("primary")
  connectedAt           DateTime @default(now())
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

// A booked consultation. `token` is the secret in the client's manage link
// (/booking/<token>). `slotKey` is the start time while confirmed and null
// once cancelled, so two confirmed bookings can't share a slot.
model Booking {
  id             String        @id @default(cuid())
  token          String        @unique @default(cuid())
  slotKey        String?       @unique
  status         BookingStatus @default(CONFIRMED)
  startAt        DateTime
  endAt          DateTime
  firstName      String
  lastName       String?
  email          String
  phone          String?
  businessName   String?
  topic          String
  contactId      String?
  googleEventId  String?
  meetLink       String?
  reminderSentAt DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([startAt])
}
